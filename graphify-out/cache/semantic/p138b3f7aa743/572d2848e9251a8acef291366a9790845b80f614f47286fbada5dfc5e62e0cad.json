{"nodes": [{"id": "readme_bettervlc", "label": "BetterVLC (project)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VLC-class desktop media player with a calmer, more considered interface; independent project inspired by VLC, not affiliated with or endorsed by VideoLAN. Deliberately does not bind libVLC; VLC's source and installed binaries are used only as behavioural references for parity targets (A-B loop, chapter navigation, track selection, playback speed, snapshots). Licensed MIT."}, {"id": "readme_native_playback", "label": "Native playback (hardware acceleration, zero remuxing)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser-friendly files play directly with hardware acceleration and zero remuxing."}, {"id": "readme_ffmpeg_pipeline", "label": "FFmpeg compatibility pipeline (remux/transcode to fMP4, MSE streaming)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything the browser cannot play natively - MKV/AVI/TS, HEVC, VP9, Opus, multi-track audio and other awkward containers - is remuxed or transcoded to fragmented MP4 and streamed through Media Source Extensions."}, {"id": "readme_library", "label": "Library (recursive scan, change watching, resume, filter, sort)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_subtitles", "label": "Subtitle engine (embedded/external SRT, ASS, SSA, VTT; custom overlay)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-selection, delay control, custom typeface, size, colour, outline and background for the custom overlay."}, {"id": "readme_player_essentials", "label": "Player essentials (chapters, A-B loop, speed, 10-band EQ, PiP, mini player)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chapters, A-B loop, 10-second skips, speed control 0.25x-4x, 10-band equalizer, rotation, zoom, colour filters, snapshots, picture-in-picture and a compact mini player."}, {"id": "readme_streams_playlists", "label": "Streams and playlists (HTTP/S, HLS, RTSP, RTMP, UDP; M3U/M3U8, PLS)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_interface", "label": "Interface (themes, command palette, drawers, context menus, drag-and-drop)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark and light themes, five accents, command palette (Ctrl+K), queue and media-info drawers, custom context menus, keyboard shortcuts and drag-and-drop."}, {"id": "readme_desktop_behaviour", "label": "Desktop behaviour (frameless chrome, media keys, single instance, open-with)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frameless chrome, media-key support, single-instance handling, open-with integration and remembered window state."}, {"id": "readme_keyboard_shortcuts", "label": "Keyboard shortcuts (Space, arrows, J/L, M, F, N/P, S, A, [ ], Q/I, Ctrl+O/U/K/L/,)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_project_layout", "label": "Project layout (src/main, src/preload, src/renderer, src/shared)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_deliberate_limitations", "label": "Deliberate limitations (DRM/Blu-ray, PGS/VobSub, 4K software transcode, URL seekability)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DRM-protected content and Blu-ray menus are out of scope. Bitmap subtitle formats (PGS, VobSub) are detected but cannot be converted to text for the custom overlay. Compatibility playback is software-transcoded, so very high-bitrate 4K files benefit from the resolution cap in Settings. Streaming from a URL depends on FFmpeg's protocol support and the source's seekability."}, {"id": "readme_electron", "label": "Electron 45 (application shell)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_react_ui", "label": "React 19 UI layer (TypeScript, Framer Motion, Lucide)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_zustand", "label": "Zustand state stores (settings, library, player, history, UI)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the state layer; stores cover settings, library, player, history and UI."}, {"id": "readme_build_tooling", "label": "Build tooling (electron-vite 6, Vite 8; npm dev/typecheck/build/dist)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production bundles go to out/; dist produces a Windows NSIS installer plus a portable build in release/."}, {"id": "readme_ffmpeg_binaries", "label": "FFmpeg/FFprobe binaries (ffmpeg-static, ffprobe-static, resources/bin)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Development expects the FFmpeg and FFprobe binaries installed by ffmpeg-static and ffprobe-static; packaged builds copy both binaries to resources/bin and use them from there."}, {"id": "readme_preload_bridge", "label": "Preload layer (typed contextBridge API)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shared_ipc", "label": "Shared IPC types and contracts (src/shared)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_main_index", "label": "src/main/index.ts (main process: window, IPC, media keys, open-with)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Described in the README project layout as the Electron main process entry handling window, IPC, media keys and open-with."}, {"id": "src_main_library", "label": "src/main/library.ts (recursive scan, persistence, file watching)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_main_probe", "label": "src/main/probe.ts (ffprobe metadata, playback planning)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor